*.fits
*.fits.gz
*.fits.fz
*.zip
*.tar
*.tar.gz
*.tgz
__MACOSX/
*.hdf5
*.h5
*.pkl
*.pickle
*.npy

# Ignore NPZ by default; preserve completeness grids (outside inputs/)
*.npz
!**/C_Mz_*.npz

# =========================================================
# Input directories: no input data in git.
# inputs/README.md describes which files go where.
# =========================================================
inputs/*
!inputs/README.md
input/*


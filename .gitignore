# Generated outputs
# =========================================================
outputs/
output/
results/
runs/
acf_results/
cache/
injection_statistics/
ipnybs/

# Derived catalogues
joined_catalog.csv
cat_r_eff.csv
CEERS_z*_selected.csv
random_catalogs/
random_catalog*.csv

# =========================================================
# HPC / PBS Pro (Pegasus)
# =========================================================
*.o[0-9]*
*.e[0-9]*
*.pbs.log
core.[0-9]*
nohup.out

